{
  "name": "edurealm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "EduRealm — data-driven educational adventure game engine (AI-ready MapSpec/LevelSpec/BattleRule)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
